# ===================================================================
# DEMO - Digital Exam Mentor (Netlify + Supabase + Paystack + Gemini)
# Environment Variables Configuration
# ===================================================================

# --- Frontend (Client-accessible via Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_PAYSTACK_PUBLIC_KEY=pk_live_or_test_key

# --- Backend / Netlify Functions Only (NEVER expose to frontend) ---
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PAYSTACK_SECRET_KEY=sk_live_or_test_key
GEMINI_API_KEY=your_gemini_api_key

# --- Production Deployment ---
NODE_ENV=production
PUBLIC_URL=https://demoexams.com.ng
