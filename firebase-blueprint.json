{
  "entities": {
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private user profile data including student profile and exam selections.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "exams": { "type": "array", "items": { "type": "string" } },
        "selectedSubjects": { "type": "object" },
        "examDates": { "type": "object" },
        "weakSubjects": { "type": "array", "items": { "type": "string" } },
        "scores": { "type": "array" },
        "referralCode": { "type": "string" },
        "referredBy": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "subscriber", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["email"]
    },
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public user profile data for leaderboards and referral tracking.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "referralCode": { "type": "string" },
        "referralCount": { "type": "number" },
        "activeReferralCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "referralCode", "referralCount", "activeReferralCount"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Authoritative subscription and trial state managed by server/Cloud Functions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["trial", "active", "expired", "cancelled"] },
        "plan": { "type": "string", "enum": ["free_trial", "premium"] },
        "trialStartedAt": { "type": "number" },
        "trialExpiresAt": { "type": "number" },
        "subscriptionStartedAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "amountPaid": { "type": "number" },
        "lastPaymentReference": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "status", "plan", "trialStartedAt", "trialExpiresAt"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Paystack transaction record verified authoritative by server.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "reference": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "channel": { "type": "string" },
        "customerEmail": { "type": "string" },
        "paidAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "reference", "amount", "currency", "status", "createdAt"]
    },
    "ExamSession": {
      "title": "ExamSession",
      "description": "Completed CBT mock exam session or practice drill.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "examType": { "type": "string", "enum": ["WAEC", "NECO", "JAMB"] },
        "subject": { "type": "string" },
        "mode": { "type": "string", "enum": ["DRILL", "FOCUS", "FULL"] },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "examType", "subject", "score", "total", "createdAt"]
    },
    "AIInteraction": {
      "title": "AIInteraction",
      "description": "Server-side logged AI tutor request and token usage for quota management.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["tutor", "questions", "essay", "study_plan"] },
        "subject": { "type": "string" },
        "examType": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "type", "timestamp"]
    },
    "Referral": {
      "title": "Referral",
      "description": "Tracks a referral relationship and anti-cheat validation.",
      "type": "object",
      "properties": {
        "referrerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active"] },
        "createdAt": { "type": "number" }
      },
      "required": ["referrerId", "status", "createdAt"]
    },
    "QuestionBankItem": {
      "title": "QuestionBankItem",
      "description": "Official past question or generated practice question stored in Firestore.",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "examType": { "type": "string" },
        "year": { "type": "number" },
        "text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "type": { "type": "string", "enum": ["OBJ", "THEORY"] }
      },
      "required": ["subjectId", "examType", "text", "correctAnswer", "type"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Privileged actions performed by system admins.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "targetUserId": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "number" }
      },
      "required": ["adminId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private user documents (read/writable by owner or admin)."
    },
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user profile for referral leaderboard."
    },
    "/subscriptions/{userId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Protected user subscriptions, written only by Cloud Functions / Admin SDK."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Paystack payment records, written only by Cloud Functions / Admin SDK."
    },
    "/exam_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ExamSession" },
      "description": "Student CBT test results and mock exam sessions."
    },
    "/ai_interactions/{interactionId}": {
      "schema": { "$ref": "#/entities/AIInteraction" },
      "description": "AI request logs for audit and rate-limiting."
    },
    "/referrals/{referredUserId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Referral relationships."
    },
    "/question_bank/{questionId}": {
      "schema": { "$ref": "#/entities/QuestionBankItem" },
      "description": "Questions bank repository."
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin action audit logs."
    }
  }
}
