rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions & Master Gates
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (request.auth.token.email is string && (
          request.auth.token.email == 'democustomersupportservices@gmail.com' ||
          request.auth.token.email == 'admin@digitalexammentor.ng'
        ))
      );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    
    function isValidUserPrivate() {
      let data = request.resource.data;
      return data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             (!('name' in data) || (data.name is string && data.name.size() < 100)) &&
             (!('exams' in data) || (data.exams is list && data.exams.size() <= 10)) &&
             (!('selectedSubjects' in data) || data.selectedSubjects is map) &&
             (!('examDates' in data) || data.examDates is map) &&
             (!('weakSubjects' in data) || (data.weakSubjects is list && data.weakSubjects.size() <= 20)) &&
             (!('scores' in data) || (data.scores is list && data.scores.size() <= 1000)) &&
             (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 20)) &&
             (!('referredBy' in data) || (data.referredBy is string && data.referredBy.size() <= 50)) &&
             (!('role' in data) || (data.role in ['student', 'subscriber', 'admin'])) &&
             (!('createdAt' in data) || data.createdAt is number);
    }
    
    function isValidUserPublic() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.referralCode is string && data.referralCode.size() > 0 && data.referralCode.size() < 20 &&
             data.referralCount is number && data.referralCount >= 0 &&
             data.activeReferralCount is number && data.activeReferralCount >= 0 &&
             data.createdAt is number;
    }
    
    function isValidExamSession() {
      let data = request.resource.data;
      return data.userId == request.auth.uid &&
             data.examType in ['WAEC', 'NECO', 'JAMB'] &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() < 100 &&
             data.score is number && data.score >= 0 &&
             data.total is number && data.total > 0 &&
             data.score <= data.total &&
             data.createdAt is number;
    }
    
    function isValidReferral() {
      let data = request.resource.data;
      return data.referrerId is string && data.referrerId.size() > 0 && data.referrerId.size() < 100 &&
             data.status in ['pending', 'active'] &&
             data.createdAt is number;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================
    
    // 1. Private User Profile
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // On create, user cannot grant themselves admin role, active subscription, or manipulated trial dates
      allow create: if isOwner(userId) && isValidUserPrivate() &&
                       (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
                       !('isPremium' in request.resource.data) &&
                       !('isSubscribed' in request.resource.data) &&
                       !('subscription' in request.resource.data);
      
      // On update, users can update profile info, but CANNOT tamper with subscriptions or roles directly
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) && isValidUserPrivate() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'isSubscribed', 'subscription', 'trialStartedAt'])
        ) ||
        // Allow legacy referral counter increment from client batch if applicable
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount', 'activeReferralCount'])
        )
      );
      
      allow delete: if isAdmin();
    }
    
    // 2. Public User Profile (Leaderboard & Referral Code Lookup)
    match /users_public/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUserPublic();
      
      allow update: if isAuthenticated() && isValidUserPublic() && (
        isAdmin() ||
        (isOwner(userId) && 
         request.resource.data.referralCount == resource.data.referralCount &&
         request.resource.data.activeReferralCount == resource.data.activeReferralCount &&
         request.resource.data.referralCode == resource.data.referralCode)
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralCount', 'activeReferralCount']) &&
          (
            (request.resource.data.referralCount == resource.data.referralCount + 1 &&
             request.resource.data.activeReferralCount == resource.data.activeReferralCount &&
             !exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
             getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerId == userId)
            ||
            (request.resource.data.activeReferralCount == resource.data.activeReferralCount + 1 &&
             request.resource.data.referralCount == resource.data.referralCount &&
             get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.status == 'pending' &&
             getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.status == 'active' &&
             getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerId == userId)
          )
        )
      );
      
      allow delete: if isAdmin();
    }
    
    // 3. Subscriptions (Authoritative: Protected from client write!)
    // Only backend Cloud Functions / Firebase Admin SDK can create or update subscriptions
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Server-only (Cloud Functions / Firebase Admin SDK)
    }
    
    // 4. Payments (Authoritative Paystack transaction records)
    // Only backend Cloud Functions / Firebase Admin SDK can write payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Server-only (Cloud Functions / Firebase Admin SDK)
    }
    
    // 5. Exam Sessions (CBT Practice logs and scores)
    match /exam_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidExamSession();
      allow update, delete: if isAdmin();
    }
    
    // 6. AI Interactions (Logs and quota usage)
    match /ai_interactions/{interactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Server-only
    }
    
    // 7. Referrals
    match /referrals/{referredUserId} {
      allow read: if isOwner(referredUserId) || (isAuthenticated() && request.auth.uid == resource.data.referrerId) || isAdmin();
      allow create: if isOwner(referredUserId) && isValidReferral() && request.resource.data.status == 'pending';
      allow update: if isOwner(referredUserId) && isValidReferral() &&
                    resource.data.status == 'pending' &&
                    request.resource.data.status == 'active' &&
                    request.resource.data.referrerId == resource.data.referrerId &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }
    
    // 8. Question Bank (Cached / Curated questions)
    match /question_bank/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // 9. Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Server-only
    }
  }
}
